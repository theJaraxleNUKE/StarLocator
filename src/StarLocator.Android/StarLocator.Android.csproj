<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <!-- Namespace deliberately NOT "StarLocator.Android": that would shadow the global Android.* namespaces. -->
    <RootNamespace>StarLocator.Droid</RootNamespace>
    <AssemblyName>StarLocator</AssemblyName>
    <ApplicationId>io.github.thejaraxlenuke.starlocator</ApplicationId>
    <ApplicationTitle>Star Locator</ApplicationTitle>
    <!-- CI overrides these: ApplicationVersion = workflow run number, ApplicationDisplayVersion = git tag. -->
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <!-- Release defaults to "aab;apk"; only the sideloadable APK is published (and env: signing passwords are APK-only). -->
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- The solver is CPU heavy; ship 64-bit ARM (all modern phones) and x64 for the emulator. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarLocator.Core\StarLocator.Core.csproj" />
  </ItemGroup>

</Project>
