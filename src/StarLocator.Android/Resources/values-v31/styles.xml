<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system launch screen shows the app icon on this background, then the
         app's own opening animation (SplashView) takes over on the same colour. -->
    <style name="Theme.StarLocator" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/starlocator_bg</item>
        <item name="android:colorBackground">@color/starlocator_bg</item>
        <item name="android:statusBarColor">@color/starlocator_bg</item>
        <item name="android:navigationBarColor">@color/starlocator_bg</item>
        <item name="android:windowSplashScreenBackground">@color/starlocator_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/starlocator_bg</item>
    </style>
</resources>
